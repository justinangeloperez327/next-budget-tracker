# Server-only PostgreSQL runtime connection. Use a pooled postgres:// URL when available.
# Prisma Accelerate prisma:// and prisma+postgres:// URLs are also supported.
DATABASE_URL=
# Optional direct postgres:// connection for migrations (recommended with pooling/Accelerate).
DIRECT_URL=
# Optional contact email; this is public and opens an email draft.
NEXT_PUBLIC_CONTACT_EMAIL=
