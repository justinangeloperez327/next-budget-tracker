generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  revision     Int       @default(0)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  expenses     Expense[]
  budgets      Budget[]
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Expense {
  id          String
  userId      String
  description String
  amount      BigInt
  category    String
  date        String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, date])
}

model Budget {
  userId String
  month  String
  amount BigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, month])
}

model AuthAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
