generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String
  passwordHash       String
  revision           Int                 @default(0)
  createdAt          DateTime            @default(now())
  sessions           Session[]
  expenses           Expense[]
  budgets            Budget[]
  governmentAccounts GovernmentAccount[]
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Expense {
  id          String
  userId      String
  description String
  amount      BigInt
  category    String
  date        String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, date])
}

model Budget {
  userId      String
  month       String
  amount      BigInt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations BudgetAllocation[]

  @@id([userId, month])
}

model BudgetAllocation {
  userId   String
  month    String
  category String
  amount   BigInt
  budget   Budget @relation(fields: [userId, month], references: [userId, month], onDelete: Cascade)

  @@id([userId, month, category])
}

model GovernmentAccount {
  id                String                   @id
  userId            String
  provider          String
  memberType        String
  accountIdentifier String?
  monthlyTarget     BigInt?
  frequency         String
  active            Boolean                  @default(true)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions     GovernmentContribution[]

  @@unique([userId, provider])
  @@index([userId])
}

model GovernmentContribution {
  id              String            @id
  accountId       String
  period          String
  amount          BigInt
  paymentDate     String?
  status          String
  referenceNumber String?
  notes           String?
  account         GovernmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, period])
}

model AuthAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
